# Jumble's settings, read by the container from /etc/jumble/jumble.env
# (owned by root, mode 600). Every variable is described in
# doc/configuration.md.

# Where people reach Jumble: https. Served by Jumble itself (MODE=https), its
# host name is the one the certificate is for.
JUMBLE_BASE_URL=https://jumble.example.org
# Where Let's Encrypt may write about the certificate, optionally.
#JUMBLE_ACME_EMAIL=ops@example.org
JUMBLE_APP_NAME=Jumble
# The community's logo (SVG or PNG, at most 200 KB), mounted into the
# container, and optionally a version for the dark theme.
#JUMBLE_LOGO=/config/logo.svg
#JUMBLE_LOGO_DARK=/config/logo-dark.svg
# The privacy page: your own text (Markdown, mounted like the logo), or an
# address for questions on Jumble's default one.
#JUMBLE_PRIVACY_FILE=/config/privacy.md
#JUMBLE_CONTACT=privacy@example.org
# The time zone dates and times are shown in.
JUMBLE_TIMEZONE=Europe/Zurich
# The language of pages and emails: en, fr, de, it, es, pt, sv, da, nb, fi
# or nl. Members may choose another in their settings.
JUMBLE_LANGUAGE=en
# Fixed once the database exists: prices are stored in this currency.
JUMBLE_CURRENCY=EUR
# How members sign in: email (a link sent by email) or oidc (a provider).
JUMBLE_SIGN_IN=email
# The community's owner, by email: can always sign in, chooses who else may,
# and appoints the moderators, in Jumble.
JUMBLE_OWNER=
# Settings without a variable here: an edn file mounted into the container.
#JUMBLE_CONFIG_FILE=/config/jumble.edn

# With JUMBLE_SIGN_IN=oidc: the OpenID Connect provider.
#JUMBLE_OIDC_ISSUER=https://accounts.google.com
#JUMBLE_OIDC_CLIENT_ID=
#JUMBLE_OIDC_CLIENT_SECRET=

# Photos: an S3-compatible bucket and a key limited to it.
JUMBLE_S3_ENDPOINT=https://s3.example.com
JUMBLE_S3_REGION=
JUMBLE_S3_BUCKET=jumble-photos
JUMBLE_S3_ACCESS_KEY=
JUMBLE_S3_SECRET_KEY=

# Database backups: another bucket on the same endpoint, versioned, and a
# key limited to it that cannot erase versions.
JUMBLE_BACKUP_BUCKET=jumble-backup
JUMBLE_BACKUP_PATH=jumble
JUMBLE_BACKUP_ACCESS_KEY=
JUMBLE_BACKUP_SECRET_KEY=
# A heartbeat monitor's address, requested while backups work, to be told
# when they stop.
# JUMBLE_BACKUP_HEARTBEAT_URL=https://hc-ping.com/your-check-id

# Email, over SMTP with STARTTLS.
JUMBLE_SMTP_HOST=smtp.example.org
JUMBLE_SMTP_PORT=587
JUMBLE_SMTP_USERNAME=
JUMBLE_SMTP_PASSWORD=
JUMBLE_MAIL_FROM=Jumble <jumble@example.org>
