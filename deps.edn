{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.13.0-alpha11"}
        com.s-exp/enso {:mvn/version "1.0.0-beta140"}
        ;; HTTP/3's native shim, for the image's platform.
        com.s-exp/enso$linux-amd64 {:mvn/version "1.0.0-beta140"}
        com.s-exp/appia {:mvn/version "1.0.0-alpha12"}
        ;; Not released yet: a pinned commit.
        com.outskirtslabs/clave {:git/url "https://github.com/outskirtslabs/clave.git"
                                 :git/sha "bfd23d048c6b1f11128dba9cb4b771823430e27c"}
        ;; clave's JSON library: from 0.1.7 it goes through oda when oda is
        ;; the only one it supports on the classpath.
        org.babashka/json {:mvn/version "0.1.7" :exclusions [org.clojure/data.json]}
        ring/ring-core {:mvn/version "1.15.6"}
        dev.onionpancakes/chassis {:mvn/version "1.0.365"}
        ;; QR codes, for the community's poster.
        io.nayuki/qrcodegen {:mvn/version "1.8.0"}
        com.s-exp/oda {:mvn/version "1.0.0-alpha47"}
        com.s-exp/ex {:mvn/version "1.0.0-alpha42"}
        com.nimbusds/nimbus-jose-jwt {:mvn/version "10.10"}
        io.github.nextjournal/markdown {:mvn/version "0.7.228"}
        org.eclipse.angus/angus-mail {:mvn/version "2.0.5"}
        com.zaxxer/HikariCP {:mvn/version "7.1.0"}
        com.github.seancorfield/next.jdbc {:mvn/version "1.4.72"}
        org.xerial/sqlite-jdbc {:mvn/version "3.53.4.0"}
        com.stuartsierra/component {:mvn/version "1.2.0"}
        aero/aero {:mvn/version "1.1.6"}
        org.clojure/tools.logging {:mvn/version "1.3.1"}
        ch.qos.logback/logback-classic {:mvn/version "1.6.6"}
        org.slf4j/jul-to-slf4j {:mvn/version "2.0.19"}}
 :aliases
 {:dev {:jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Djava.awt.headless=true" "-Djumble.profile=dev"]
        :extra-paths ["dev" "test"]
        :extra-deps {com.s-exp/enso$darwin-arm64 {:mvn/version "1.0.0-beta140"}}}
  ;; clojure -M:dev:seed [--reset], with the docker compose services running
  :seed {:main-opts ["-m" "seed"]}
  :nrepl {:extra-deps {nrepl/nrepl {:mvn/version "1.3.1"}}
          :main-opts ["-m" "nrepl.cmdline"]}
  :test {:jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Djava.awt.headless=true" "-Djumble.profile=dev"]
         :extra-paths ["test" "test-resources" "dev"]
         :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                      com.s-exp/enso$darwin-arm64 {:mvn/version "1.0.0-beta140"}
                      ;; Reads QR codes back, to check ours say what they should.
                      com.google.zxing/javase {:mvn/version "3.5.3"}}
         :main-opts ["-m" "kaocha.runner" "unit"]}
  ;; clojure -M:test:integration, with the docker compose services running
  :integration {:main-opts ["-m" "kaocha.runner" "integration"]}
  ;; clojure -T:build uber
  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
          :ns-default build}
  :run {:jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Djava.awt.headless=true"]
        :extra-deps {com.s-exp/enso$darwin-arm64 {:mvn/version "1.0.0-beta140"}}
        :main-opts ["-m" "s-exp.jumble"]}}}
