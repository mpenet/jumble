msgstr "Trekk tilbake {pattern}"

#: src/s_exp/jumble/moderation/view.clj
msgid "Withdraw"
msgstr "Trekk tilbake"

#: src/s_exp/jumble/moderation/view.clj
msgid "Nobody yet."
msgstr "Ingen ennå."

#: src/s_exp/jumble/moderation/view.clj
msgid "Add addresses or patterns"
msgstr "Legg til adresser eller mønstre"

#: src/s_exp/jumble/moderation/view.clj
msgid "One per line, or separated by commas. Withdrawing one signs out the people only it let in, at once; their accounts stay."
msgstr "Én per linje, eller skilt med komma. Trekker du tilbake én, logges de som bare den slapp inn, ut med en gang; kontoene deres blir værende."

#: src/s_exp/jumble/moderation/view.clj
msgid "Email an invitation to the addresses"
msgstr "Send en invitasjon på e-post til adressene"

#: src/s_exp/jumble/moderation/view.clj
msgid "Added."
msgstr "Lagt til."

