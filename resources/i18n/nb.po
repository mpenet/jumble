msgstr "Om 7 dager"

#: src/s_exp/jumble/moderation/view.clj
msgid "Join link"
msgstr "Invitasjonslenke"

#: src/s_exp/jumble/moderation/view.clj
msgid "Anyone with a join link can join, without being on the list: share it, or print it on the poster."
msgstr "Alle med en invitasjonslenke kan bli med uten å stå på listen: del den, eller skriv den ut på plakaten."

#: src/s_exp/jumble/moderation/view.clj
msgid "Create a join link"
msgstr "Lag en invitasjonslenke"

#: src/s_exp/jumble/moderation/view.clj
msgid "Made by {who}, {date}."
msgstr "Laget av {who}, {date}."

#: src/s_exp/jumble/moderation/view.clj
msgid "a former member"
msgstr "et tidligere medlem"

#: src/s_exp/jumble/moderation/view.clj
msgid "Works until {date}."
msgstr "Gjelder til {date}."

#: src/s_exp/jumble/moderation/view.clj
msgid "Never expires."
msgstr "Utløper aldri."

#: src/s_exp/jumble/moderation/view.clj
msgid "Anyone holding it, a photo of the poster included, can join. Renew it to stop this one working, or turn it off."
msgstr "Alle som har den, også via et bilde av plakaten, kan bli med. Forny den så denne slutter å virke, eller slå den av."

#: src/s_exp/jumble/moderation/view.clj
msgid "Renew"
msgstr "Forny"

#: src/s_exp/jumble/moderation/view.clj
msgid "Turn off the join link"
msgstr "Slå av invitasjonslenken"

#: src/s_exp/jumble/moderation/view.clj
msgid "Members' invitations"
msgstr "Medlemmenes invitasjoner"

#: src/s_exp/jumble/moderation/view.clj
msgid "Members can invite people by email, {count} a day each. Whom they invited is listed below, to withdraw like any other address."
msgstr "Medlemmer kan invitere folk via e-post, {count} om dagen hver. De som er invitert står nedenfor og kan trekkes tilbake som enhver annen adresse."

#: src/s_exp/jumble/moderation/view.clj
msgid "Members cannot invite people. Once you let them, each can invite {count} a day by email."
msgstr "Medlemmer kan ikke invitere noen. Hvis du tillater det, kan hver invitere {count} om dagen via e-post."

#: src/s_exp/jumble/moderation/view.clj
msgid "Stop members inviting people"
msgstr "La ikke lenger medlemmer invitere"

#: src/s_exp/jumble/moderation/view.clj
msgid "Let members invite people"
msgstr "La medlemmer invitere folk"

#: src/s_exp/jumble/moderation/view.clj
msgid "Addresses and patterns: {person} for one person, {domain} for a domain, {subdomains} for its subdomains."
msgstr "Adresser og mønstre: {person} for én person, {domain} for et domene, {subdomains} for underdomenene."

#: src/s_exp/jumble/moderation/view.clj
msgid "Anyone can sign in: the configuration lets everyone in. Restrict it there to manage who may sign in here."
msgstr "Alle kan logge inn: konfigurasjonen slipper inn alle. Begrens den der for å styre her hvem som kan logge inn."

#: src/s_exp/jumble/moderation/view.clj
msgid "From the configuration"
msgstr "Fra konfigurasjonen"

