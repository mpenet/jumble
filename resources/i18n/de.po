msgstr "Diese Anfrage konnte nicht verstanden werden."

#: src/s_exp/jumble/error/view.clj
msgid "Too large"
msgstr "Zu groß"

#: src/s_exp/jumble/error/view.clj
msgid "That request was larger than allowed."
msgstr "Diese Anfrage war größer als erlaubt."

