msgid "Sign in"
msgstr "Anmelden"

#: src/s_exp/jumble/account/view.clj
msgid "Enter your email address and we will send you a link to sign in."
msgstr "Gib deine E-Mail-Adresse ein, dann schicken wir dir einen Anmeldelink."

#: src/s_exp/jumble/account/view.clj
msgid "Join {app-name}"
msgstr "{app-name} beitreten"

#: src/s_exp/jumble/account/view.clj
msgid "You are invited to {app-name}, where members sell, give away and lend things to each other."
msgstr "Du bist zu {app-name} eingeladen. Dort verkaufen, verschenken und verleihen Mitglieder einander Dinge."

