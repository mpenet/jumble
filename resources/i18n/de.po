msgstr "Name"

#: src/s_exp/jumble/account/view.clj
msgid "Shown to other members on your listings and messages."
msgstr "Wird anderen Mitgliedern bei deinen Anzeigen und Nachrichten angezeigt."

#: src/s_exp/jumble/account/view.clj
msgid "Language"
msgstr "Sprache"

