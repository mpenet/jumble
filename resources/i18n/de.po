msgstr "Tickets & Gutscheine"

#: src/s_exp/jumble/listing/choices.clj
msgid "Other"
msgstr "Sonstiges"

#: src/s_exp/jumble/listing/choices.clj
msgid "Give it a name."
msgstr "Gib einen Namen ein."

#: src/s_exp/jumble/listing/choices.clj
msgid "Keep the name to {max} characters or fewer."
msgstr "Der Name darf höchstens {max} Zeichen lang sein."

#: src/s_exp/jumble/listing/choices.clj
msgid "There is already one named “{label}”."
msgstr "Es gibt schon einen Eintrag namens „{label}“."

#: src/s_exp/jumble/listing/choices.clj
msgid "Keep at least one category."
msgstr "Mindestens eine Kategorie muss bleiben."

