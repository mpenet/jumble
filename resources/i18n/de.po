#: src/s_exp/jumble/account/controller.clj
msgid "Sign in again"
msgstr "Erneut anmelden"

#: src/s_exp/jumble/account/controller.clj
msgid "Sign-in unavailable"
msgstr "Anmeldung nicht verfügbar"

#: src/s_exp/jumble/account/controller.clj
msgid "The sign-in service cannot be reached right now. Please try again shortly."
msgstr "Der Anmeldedienst ist gerade nicht erreichbar. Bitte versuch es gleich noch einmal."

#: src/s_exp/jumble/account/controller.clj src/s_exp/jumble/listing/controller.clj
msgid "Try again"
msgstr "Erneut versuchen"

#: src/s_exp/jumble/account/controller.clj
msgid "Too many sign-ins"
msgstr "Zu viele Anmeldungen"

#: src/s_exp/jumble/account/controller.clj
msgid "Too many sign-ins were started from here. Please try again in a few minutes."
msgstr "Von hier wurden zu viele Anmeldungen begonnen. Bitte versuche es in ein paar Minuten noch einmal."

#: src/s_exp/jumble/account/controller.clj
msgid "Account not allowed"
msgstr "Konto nicht zugelassen"

#: src/s_exp/jumble/account/controller.clj
msgid "Only members of this community can sign in here."
msgstr "Hier können sich nur Mitglieder dieser Gemeinschaft anmelden."

#: src/s_exp/jumble/account/controller.clj
msgid "This community is full"
msgstr "Diese Gemeinschaft ist voll"

#: src/s_exp/jumble/account/controller.clj
msgid "It has as many members as it can have. Ask its moderators to make room."
msgstr "Sie hat so viele Mitglieder, wie sie haben kann. Bitte die Moderatoren, Platz zu schaffen."

#: src/s_exp/jumble/account/controller.clj
msgid "Enter your email address."
msgstr "Gib deine E-Mail-Adresse ein."

#: src/s_exp/jumble/account/controller.clj
msgid "“{email}” is not an email address."
msgstr "„{email}“ ist keine E-Mail-Adresse."

#: src/s_exp/jumble/account/controller.clj
msgid "Link expired"
msgstr "Link abgelaufen"

#: src/s_exp/jumble/account/controller.clj
msgid "This sign-in link has expired or was already used."
msgstr "Dieser Anmeldelink ist abgelaufen oder wurde schon verwendet."

#: src/s_exp/jumble/account/controller.clj
msgid "Get a new link"
msgstr "Neuen Link anfordern"

#: src/s_exp/jumble/account/controller.clj
msgid "This join link no longer works. Ask the community's moderators for the current one."
msgstr "Dieser Beitrittslink funktioniert nicht mehr. Frag die Moderatoren der Community nach dem aktuellen."

#: src/s_exp/jumble/account/controller.clj
msgid "Sign-in expired"
msgstr "Anmeldung abgelaufen"

#: src/s_exp/jumble/account/controller.clj
msgid "This sign-in is invalid or has expired."
msgstr "Diese Anmeldung ist ungültig oder abgelaufen."

#: src/s_exp/jumble/account/controller.clj
msgid "Sign-in refused"
msgstr "Anmeldung abgelehnt"

#: src/s_exp/jumble/account/controller.clj
msgid "The sign-in service refused the request."
msgstr "Der Anmeldedienst hat die Anfrage abgelehnt."

#: src/s_exp/jumble/account/controller.clj
msgid "Email not verified"
msgstr "E-Mail-Adresse nicht bestätigt"

#: src/s_exp/jumble/account/controller.clj
msgid "The sign-in service has not verified your email address."
msgstr "Der Anmeldedienst hat deine E-Mail-Adresse nicht bestätigt."

#: src/s_exp/jumble/account/controller.clj
msgid "Sign-in failed"
msgstr "Anmeldung fehlgeschlagen"

#: src/s_exp/jumble/account/controller.clj
msgid "Something went wrong while signing you in."
msgstr "Bei der Anmeldung ist etwas schiefgelaufen."

#: src/s_exp/jumble/account/controller.clj
msgid "Your account was deleted"
msgstr "Dein Konto wurde gelöscht"

#: src/s_exp/jumble/account/controller.clj
msgid "Your listings, photos and favorites are gone. Messages you sent stay with the people you wrote to, from \"A former member\"."
msgstr "Deine Anzeigen, Fotos und Favoriten sind gelöscht. Nachrichten, die du gesendet hast, bleiben bei den Personen, denen du geschrieben hast – mit „Ein ehemaliges Mitglied“ als Absender."

#: src/s_exp/jumble/account/controller.clj
msgid "Done"
msgstr "Fertig"

#: src/s_exp/jumble/account/email.clj
msgid "Sign in to {app-name}"
msgstr "Bei {app-name} anmelden"

#: src/s_exp/jumble/account/email.clj
msgid "Use this link to sign in to {app-name}:"
msgstr "Mit diesem Link meldest du dich bei {app-name} an:"

#: src/s_exp/jumble/account/email.clj
msgid "It works once, within {n} minute. If you did not ask for it, you can\nignore this email: nobody can sign in without the link."
msgid_plural "It works once, within {n} minutes. If you did not ask for it, you can\nignore this email: nobody can sign in without the link."
msgstr[0] "Er gilt nur einmal und nur {n} Minute lang. Wenn du ihn nicht angefordert hast, kannst du\ndiese E-Mail ignorieren: Ohne den Link kann sich niemand anmelden."
msgstr[1] "Er gilt nur einmal und nur {n} Minuten lang. Wenn du ihn nicht angefordert hast, kannst du\ndiese E-Mail ignorieren: Ohne den Link kann sich niemand anmelden."

#: src/s_exp/jumble/account/email.clj
msgid "You are invited to {app-name}"
msgstr "Du bist zu {app-name} eingeladen"

#: src/s_exp/jumble/account/email.clj
msgid "{inviter} invited you to {app-name}, where members sell, give away and lend things to each other."
msgstr "{inviter} hat dich zu {app-name} eingeladen. Dort verkaufen, verschenken und verleihen Mitglieder einander Dinge."

#: src/s_exp/jumble/account/email.clj
msgid "Sign in with this address: {url}"
msgstr "Melde dich mit dieser E-Mail-Adresse an: {url}"

#: src/s_exp/jumble/account/membership.clj
msgid "Not an email pattern: {pattern} (use *, name@domain, *@domain or *@*.domain)"
msgstr "Kein gültiges E-Mail-Muster: {pattern} (verwende *, name@domain, *@domain oder *@*.domain)"

#: src/s_exp/jumble/account/model.clj
msgid "Enter your name."
msgstr "Gib deinen Namen ein."

#: src/s_exp/jumble/account/model.clj
msgid "Keep your name to 80 characters or fewer."
msgstr "Dein Name darf höchstens 80 Zeichen lang sein."

#: src/s_exp/jumble/account/view.clj
msgid "Notifications on this device"
msgstr "Benachrichtigungen auf diesem Gerät"

#: src/s_exp/jumble/account/view.clj
msgid "Get a notification here as soon as someone writes to you, even with {app-name} closed."
msgstr "Erhalte hier eine Benachrichtigung, sobald dir jemand schreibt – auch wenn {app-name} geschlossen ist."

#: src/s_exp/jumble/account/view.clj
msgid "Notify me on this device"
msgstr "Auf diesem Gerät benachrichtigen"

#: src/s_exp/jumble/account/view.clj
msgid "Stop on this device"
msgstr "Auf diesem Gerät beenden"

#: src/s_exp/jumble/account/view.clj
msgid "This browser cannot show notifications."
msgstr "Dieser Browser kann keine Benachrichtigungen anzeigen."

#: src/s_exp/jumble/account/view.clj src/s_exp/jumble/error/view.clj
msgid "Something went wrong"
msgstr "Etwas ist schiefgelaufen"

#: src/s_exp/jumble/account/view.clj
msgid "Notifications are blocked for this site: allow them in the browser's settings, then try again."
msgstr "Benachrichtigungen sind für diese Website blockiert: erlaube sie in den Browsereinstellungen und versuch es dann noch einmal."

#: src/s_exp/jumble/account/view.clj
msgid "On iPhone and iPad, add {app-name} to your home screen first, then turn notifications on from there."
msgstr "Füge {app-name} auf iPhone und iPad zuerst zu deinem Home-Bildschirm hinzu und schalte die Benachrichtigungen dann von dort aus ein."

#: src/s_exp/jumble/account/view.clj
msgid "Devices notified"
msgstr "Benachrichtigte Geräte"

#: src/s_exp/jumble/account/view.clj
msgid "Added {date}"
msgstr "Hinzugefügt am {date}"

#: src/s_exp/jumble/account/view.clj
msgid "This device"
msgstr "Dieses Gerät"

#: src/s_exp/jumble/account/view.clj src/s_exp/jumble/listing/view.clj
msgid "Remove"
msgstr "Entfernen"

