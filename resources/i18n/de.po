msgid "Search listings"
msgstr "Anzeigen durchsuchen"

#: src/s_exp/jumble/home/view.clj
msgid "Search"
msgstr "Suchen"

#: src/s_exp/jumble/home/view.clj
msgid "{n} thing up for grabs right now"
msgid_plural "{n} things up for grabs right now"
msgstr[0] "{n} Sache ist gerade zu haben"
msgstr[1] "{n} Sachen sind gerade zu haben"

