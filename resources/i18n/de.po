#: src/s_exp/jumble/moderation/view.clj
msgid "Remove a member"
msgstr "Mitglied entfernen"

#: src/s_exp/jumble/moderation/view.clj
msgid "Their email address"
msgstr "Ihre E-Mail-Adresse"

#: src/s_exp/jumble/moderation/view.clj
msgid "Their account and listings are deleted for good, and they can never sign in again."
msgstr "Konto und Anzeigen werden endgültig gelöscht, und die Person kann sich nie wieder anmelden."

#: src/s_exp/jumble/moderation/view.clj
msgid "Removed."
msgstr "Entfernt."

#: src/s_exp/jumble/moderation/view.clj
msgid "Remove…"
msgstr "Entfernen…"

#: src/s_exp/jumble/moderation/view.clj
msgid "Remove {name}?"
msgstr "{name} entfernen?"

#: src/s_exp/jumble/moderation/view.clj
msgid "{name} ({email}) and their account are deleted, and they can never sign in again. Their messages stay, from a former member. This cannot be undone."
msgstr "Das Konto von {name} ({email}) wird gelöscht, und die Person kann sich nie wieder anmelden. Ihre Nachrichten bleiben, von einem ehemaligen Mitglied. Das lässt sich nicht rückgängig machen."

#: src/s_exp/jumble/moderation/view.clj
msgid "{name} ({email}) and their account are deleted, with {listings} and their photos, and they can never sign in again. Their messages stay, from a former member. This cannot be undone."
msgstr "Das Konto von {name} ({email}) wird gelöscht, mit {listings} samt Fotos, und die Person kann sich nie wieder anmelden. Ihre Nachrichten bleiben, von einem ehemaligen Mitglied. Das lässt sich nicht rückgängig machen."

#: src/s_exp/jumble/moderation/view.clj
msgid "Remove for good"
msgstr "Endgültig entfernen"

#: src/s_exp/jumble/moderation/view.clj
