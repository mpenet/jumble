msgid "Done"
msgstr "Terminé"

#: src/s_exp/jumble/account/email.clj
msgid "Sign in to {app-name}"
msgstr "Connexion à {app-name}"

#: src/s_exp/jumble/account/email.clj
msgid "Use this link to sign in to {app-name}:"
msgstr "Utilisez ce lien pour vous connecter à {app-name} :"

