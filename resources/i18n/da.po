#: src/s_exp/jumble/account/controller.clj
msgid "Sign in again"
msgstr "Log ind igen"

#: src/s_exp/jumble/account/controller.clj
msgid "Sign-in unavailable"
msgstr "Login er ikke tilgængeligt"

