msgid "This join link no longer works. Ask the community's moderators for the current one."
msgstr "Dette invitationslink virker ikke længere. Bed fællesskabets moderatorer om det aktuelle."

#: src/s_exp/jumble/account/controller.clj
msgid "Sign-in expired"
msgstr "Login udløbet"

#: src/s_exp/jumble/account/controller.clj
msgid "This sign-in is invalid or has expired."
msgstr "Dette login er ugyldigt eller udløbet."

#: src/s_exp/jumble/account/controller.clj
msgid "Sign-in refused"
msgstr "Login afvist"

