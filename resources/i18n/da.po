#: src/s_exp/jumble/moderation/view.clj
msgid "Remove {name}?"
msgstr "Fjern {name}?"

#: src/s_exp/jumble/moderation/view.clj
msgid "{name} ({email}) and their account are deleted, and they can never sign in again. Their messages stay, from a former member. This cannot be undone."
msgstr "Kontoen for {name} ({email}) slettes, og vedkommende kan aldrig logge ind igen. Beskederne bliver liggende, nu fra et tidligere medlem. Det kan ikke fortrydes."

#: src/s_exp/jumble/moderation/view.clj
msgid "{name} ({email}) and their account are deleted, with {listings} and their photos, and they can never sign in again. Their messages stay, from a former member. This cannot be undone."
msgstr "Kontoen for {name} ({email}) slettes sammen med {listings} og billederne, og vedkommende kan aldrig logge ind igen. Beskederne bliver liggende, nu fra et tidligere medlem. Det kan ikke fortrydes."

#: src/s_exp/jumble/moderation/view.clj
msgid "Remove for good"
msgstr "Fjern for altid"

