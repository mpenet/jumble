msgstr "Om 7 dage"

#: src/s_exp/jumble/moderation/view.clj
msgid "Join link"
msgstr "Invitationslink"

#: src/s_exp/jumble/moderation/view.clj
msgid "Anyone with a join link can join, without being on the list: share it, or print it on the poster."
msgstr "Alle med et invitationslink kan blive medlem uden at stå på listen: del det, eller udskriv det på plakaten."

#: src/s_exp/jumble/moderation/view.clj
msgid "Create a join link"
msgstr "Opret et invitationslink"

#: src/s_exp/jumble/moderation/view.clj
msgid "Made by {who}, {date}."
msgstr "Oprettet af {who}, {date}."

#: src/s_exp/jumble/moderation/view.clj
