msgid "joined with the join link, {date}"
msgstr "blev medlem via invitationslinket, {date}"

#: src/s_exp/jumble/moderation/view.clj
msgid "added by {who}, {date}"
msgstr "tilføjet af {who}, {date}"

#: src/s_exp/jumble/moderation/view.clj
