msgstr "et tidligere medlem"

#: src/s_exp/jumble/moderation/view.clj
msgid "Works until {date}."
msgstr "Gælder til {date}."

#: src/s_exp/jumble/moderation/view.clj
msgid "Never expires."
msgstr "Udløber aldrig."

#: src/s_exp/jumble/moderation/view.clj
msgid "Anyone holding it, a photo of the poster included, can join. Renew it to stop this one working, or turn it off."
msgstr "Alle, der har det, også via et foto af plakaten, kan blive medlem. Forny det, så dette holder op med at virke, eller slå det fra."

#: src/s_exp/jumble/moderation/view.clj
