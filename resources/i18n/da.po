msgid "Retire {label}"
msgstr "Udfas {label}"

#: src/s_exp/jumble/moderation/view.clj
msgid "None offered."
msgstr "Ingen valgmuligheder."

#: src/s_exp/jumble/moderation/view.clj
msgid "Retired"
msgstr "Udfasede"

#: src/s_exp/jumble/moderation/view.clj
msgid "No longer offered. Their listings keep them."
msgstr "Tilbydes ikke længere. Eksisterende annoncer beholder dem."

#: src/s_exp/jumble/moderation/view.clj
msgid "Restore"
msgstr "Gendan"

#: src/s_exp/jumble/moderation/view.clj
msgid "Restore {label}"
msgstr "Gendan {label}"

#: src/s_exp/jumble/moderation/view.clj
msgid "The colours of every page, for everyone. Each palette has a light and a dark side: members see the one they chose, or their device's."
msgstr "Farverne på alle sider, for alle. Hver palet har en lys og en mørk side: medlemmerne ser den, de har valgt, eller den, deres enhed bruger."

#: src/s_exp/jumble/moderation/view.clj
msgid "Palette"
msgstr "Palet"

#: src/s_exp/jumble/moderation/view.clj
msgid "Print it for a noticeboard, by the coffee machine or the lift: whoever scans it lands on {app-name}."
msgstr "Print den til en opslagstavle, ved kaffemaskinen eller elevatoren: den, der scanner den, lander på {app-name}."

#: src/s_exp/jumble/moderation/view.clj
msgid "Print"
msgstr "Print"

#: src/s_exp/jumble/moderation/view.clj
msgid "Scan to open {app-name}"
msgstr "Scan for at åbne {app-name}"

#: src/s_exp/jumble/moderation/view.clj
msgid "Point your phone's camera at the code"
msgstr "Ret mobilens kamera mod koden"

#: src/s_exp/jumble/moderation/view.clj
msgid "Post what you no longer need, or find what you need"
msgstr "Annoncér det, du ikke længere har brug for, eller find det, du mangler"

#: src/s_exp/jumble/moderation/view.clj
