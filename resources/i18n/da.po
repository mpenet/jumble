msgstr "Tilbagekald"

#: src/s_exp/jumble/moderation/view.clj
msgid "Nobody yet."
msgstr "Ingen endnu."

#: src/s_exp/jumble/moderation/view.clj
msgid "Add addresses or patterns"
msgstr "Tilføj adresser eller mønstre"

#: src/s_exp/jumble/moderation/view.clj
msgid "One per line, or separated by commas. Withdrawing one signs out the people only it let in, at once; their accounts stay."
msgstr "Én pr. linje eller adskilt med kommaer. Tilbagekalder du en, bliver de, der kun havde adgang gennem den, logget ud med det samme; deres konti bliver."

#: src/s_exp/jumble/moderation/view.clj
msgid "Email an invitation to the addresses"
msgstr "Send en invitation på e-mail til adresserne"

#: src/s_exp/jumble/moderation/view.clj
