msgstr "Slå invitationslinket fra"

#: src/s_exp/jumble/moderation/view.clj
msgid "Addresses and patterns: {person} for one person, {domain} for a domain, {subdomains} for its subdomains."
msgstr "Adresser og mønstre: {person} for én person, {domain} for et domæne, {subdomains} for dets underdomæner."

#: src/s_exp/jumble/moderation/view.clj
msgid "Anyone can sign in: the configuration lets everyone in. Restrict it there to manage who may sign in here."
msgstr "Alle kan logge ind: konfigurationen giver alle adgang. Begræns den dér for at styre, hvem der kan logge ind her."

