msgid_plural "You posted \"{title}\" on {app-name} {n} days ago or more."
msgstr[0] "Du oprettede »{title}« på {app-name} for mindst {n} dag siden."
msgstr[1] "Du oprettede »{title}« på {app-name} for mindst {n} dage siden."

