msgid "Notifications are blocked for this site: allow them in the browser's settings, then try again."
msgstr "Notifikationer er blokeret for dette websted: tillad dem i browserens indstillinger, og prøv så igen."

#: src/s_exp/jumble/account/view.clj
msgid "On iPhone and iPad, add {app-name} to your home screen first, then turn notifications on from there."
msgstr "På iPhone og iPad skal du først føje {app-name} til din hjemmeskærm og derefter slå notifikationer til derfra."

#: src/s_exp/jumble/account/view.clj
msgid "Devices notified"
msgstr "Enheder med notifikationer"

#: src/s_exp/jumble/account/view.clj
msgid "Added {date}"
msgstr "Tilføjet {date}"

#: src/s_exp/jumble/account/view.clj
msgid "This device"
msgstr "Denne enhed"

#: src/s_exp/jumble/account/view.clj src/s_exp/jumble/listing/view.clj
msgid "Remove"
msgstr "Fjern"

