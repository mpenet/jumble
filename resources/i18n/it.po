#: src/s_exp/jumble/account/controller.clj
msgid "Sign in again"
msgstr "Accedi di nuovo"

#: src/s_exp/jumble/account/controller.clj
msgid "Sign-in unavailable"
msgstr "Accesso non disponibile"

