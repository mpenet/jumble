#: src/s_exp/jumble/account/controller.clj src/s_exp/jumble/account/view.clj src/s_exp/jumble/page/privacy.clj src/s_exp/jumble/view/layout.clj
msgid "Settings"
msgstr "Impostazioni"

#: src/s_exp/jumble/account/controller.clj
msgid "Enter an email address."
msgstr "Inserisci un indirizzo email."

