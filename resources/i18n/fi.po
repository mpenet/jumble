msgid "No longer offered. Their listings keep them."
msgstr "Ei enää tarjolla. Ilmoitukset, joissa niitä on käytetty, säilyttävät ne."

#: src/s_exp/jumble/moderation/view.clj
msgid "Restore"
msgstr "Palauta"

#: src/s_exp/jumble/moderation/view.clj
msgid "Restore {label}"
msgstr "Palauta: {label}"

#: src/s_exp/jumble/moderation/view.clj
msgid "The colours of every page, for everyone. Each palette has a light and a dark side: members see the one they chose, or their device's."
msgstr "Kaikkien sivujen värit kaikille. Jokaisessa paletissa on vaalea ja tumma puoli: jäsenet näkevät valitsemansa tai laitteensa mukaisen."

#: src/s_exp/jumble/moderation/view.clj
