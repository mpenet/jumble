msgstr "liittymislinkin"

#: src/s_exp/jumble/moderation/view.clj
msgid "Point your phone's camera at the code"
msgstr "Suuntaa puhelimen kamera koodiin"

#: src/s_exp/jumble/moderation/view.clj
msgid "Post what you no longer need, or find what you need"
msgstr "Jätä ilmoitus tarpeettomista tavaroista tai löydä tarvitsemasi"

