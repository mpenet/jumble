#: src/s_exp/jumble/account/controller.clj
msgid "Sign in again"
msgstr "Kirjaudu uudelleen"

#: src/s_exp/jumble/account/controller.clj
msgid "Sign-in unavailable"
msgstr "Kirjautuminen ei ole käytettävissä"

#: src/s_exp/jumble/account/controller.clj
msgid "The sign-in service cannot be reached right now. Please try again shortly."
msgstr "Kirjautumispalveluun ei saada juuri nyt yhteyttä. Yritä hetken päästä uudelleen."

#: src/s_exp/jumble/account/controller.clj src/s_exp/jumble/listing/controller.clj
msgid "Try again"
msgstr "Yritä uudelleen"

#: src/s_exp/jumble/account/controller.clj
msgid "Too many sign-ins"
msgstr "Liikaa kirjautumisia"

#: src/s_exp/jumble/account/controller.clj
msgid "Too many sign-ins were started from here. Please try again in a few minutes."
msgstr "Täältä on aloitettu liian monta kirjautumista. Yritä uudelleen muutaman minuutin päästä."

#: src/s_exp/jumble/account/controller.clj
msgid "Account not allowed"
msgstr "Tilillä ei ole pääsyä"

#: src/s_exp/jumble/account/controller.clj
msgid "Only members of this community can sign in here."
msgstr "Vain tämän yhteisön jäsenet voivat kirjautua tänne."

#: src/s_exp/jumble/account/controller.clj
msgid "This community is full"
msgstr "Yhteisö on täynnä"

#: src/s_exp/jumble/account/controller.clj
msgid "It has as many members as it can have. Ask its moderators to make room."
msgstr "Siinä on jo niin monta jäsentä kuin mahtuu. Pyydä moderaattoreita tekemään tilaa."

#: src/s_exp/jumble/account/controller.clj
msgid "Enter your email address."
msgstr "Anna sähköpostiosoitteesi."

#: src/s_exp/jumble/account/controller.clj
msgid "“{email}” is not an email address."
msgstr "”{email}” ei ole sähköpostiosoite."

#: src/s_exp/jumble/account/controller.clj
msgid "Link expired"
msgstr "Linkki on vanhentunut"

#: src/s_exp/jumble/account/controller.clj
msgid "This sign-in link has expired or was already used."
msgstr "Tämä kirjautumislinkki on vanhentunut tai jo käytetty."

#: src/s_exp/jumble/account/controller.clj
msgid "Get a new link"
msgstr "Tilaa uusi linkki"

#: src/s_exp/jumble/account/controller.clj
msgid "This join link no longer works. Ask the community's moderators for the current one."
msgstr "Tämä liittymislinkki ei enää toimi. Pyydä nykyinen linkki yhteisön moderaattoreilta."

#: src/s_exp/jumble/account/controller.clj
msgid "Sign-in expired"
msgstr "Kirjautuminen vanhentui"

#: src/s_exp/jumble/account/controller.clj
msgid "This sign-in is invalid or has expired."
msgstr "Tämä kirjautuminen on virheellinen tai vanhentunut."

#: src/s_exp/jumble/account/controller.clj
msgid "Sign-in refused"
msgstr "Kirjautuminen hylättiin"

#: src/s_exp/jumble/account/controller.clj
msgid "The sign-in service refused the request."
msgstr "Kirjautumispalvelu hylkäsi pyynnön."

#: src/s_exp/jumble/account/controller.clj
msgid "Email not verified"
msgstr "Sähköpostiosoitetta ei ole vahvistettu"

#: src/s_exp/jumble/account/controller.clj
msgid "The sign-in service has not verified your email address."
msgstr "Kirjautumispalvelu ei ole vahvistanut sähköpostiosoitettasi."

#: src/s_exp/jumble/account/controller.clj
msgid "Sign-in failed"
msgstr "Kirjautuminen epäonnistui"

#: src/s_exp/jumble/account/controller.clj
msgid "Something went wrong while signing you in."
msgstr "Kirjautumisessa meni jokin vikaan."

#: src/s_exp/jumble/account/controller.clj
msgid "Your account was deleted"
msgstr "Tilisi on poistettu"

#: src/s_exp/jumble/account/controller.clj
msgid "Your listings, photos and favorites are gone. Messages you sent stay with the people you wrote to, from \"A former member\"."
msgstr "Ilmoituksesi, kuvasi ja suosikkisi on poistettu. Lähettämäsi viestit jäävät vastaanottajille nimellä ”Entinen jäsen”."

#: src/s_exp/jumble/account/controller.clj
msgid "Done"
msgstr "Valmis"

#: src/s_exp/jumble/account/email.clj
msgid "Sign in to {app-name}"
msgstr "Kirjaudu palveluun {app-name}"

#: src/s_exp/jumble/account/email.clj
msgid "Use this link to sign in to {app-name}:"
msgstr "Kirjaudu palveluun {app-name} tällä linkillä:"

#: src/s_exp/jumble/account/email.clj
msgid "It works once, within {n} minute. If you did not ask for it, you can\nignore this email: nobody can sign in without the link."
msgid_plural "It works once, within {n} minutes. If you did not ask for it, you can\nignore this email: nobody can sign in without the link."
msgstr[0] "Linkki toimii kerran, {n} minuutin ajan. Jos et pyytänyt sitä, voit\njättää tämän viestin huomiotta: kukaan ei voi kirjautua ilman linkkiä."
msgstr[1] "Linkki toimii kerran, {n} minuutin ajan. Jos et pyytänyt sitä, voit\njättää tämän viestin huomiotta: kukaan ei voi kirjautua ilman linkkiä."

#: src/s_exp/jumble/account/email.clj
msgid "You are invited to {app-name}"
msgstr "Sinut on kutsuttu palveluun {app-name}"

#: src/s_exp/jumble/account/email.clj
msgid "{inviter} invited you to {app-name}, where members sell, give away and lend things to each other."
msgstr "{inviter} kutsui sinut palveluun {app-name}, jossa jäsenet myyvät, antavat ja lainaavat tavaroita toisilleen."

#: src/s_exp/jumble/account/email.clj
msgid "Sign in with this address: {url}"
msgstr "Kirjaudu tällä osoitteella: {url}"

#: src/s_exp/jumble/account/membership.clj
msgid "Not an email pattern: {pattern} (use *, name@domain, *@domain or *@*.domain)"
msgstr "Ei kelvollinen osoitemalli: {pattern} (käytä muotoa *, nimi@verkkotunnus, *@verkkotunnus tai *@*.verkkotunnus)"

#: src/s_exp/jumble/account/model.clj
msgid "Enter your name."
msgstr "Anna nimesi."

#: src/s_exp/jumble/account/model.clj
msgid "Keep your name to 80 characters or fewer."
msgstr "Nimessä voi olla enintään 80 merkkiä."

#: src/s_exp/jumble/account/view.clj
msgid "Notifications on this device"
msgstr "Push-ilmoitukset tällä laitteella"

#: src/s_exp/jumble/account/view.clj
msgid "Get a notification here as soon as someone writes to you, even with {app-name} closed."
msgstr "Saat tänne push-ilmoituksen heti, kun joku kirjoittaa sinulle, vaikka palvelu {app-name} olisi suljettuna."

#: src/s_exp/jumble/account/view.clj
msgid "Notify me on this device"
msgstr "Ilmoita minulle tällä laitteella"

#: src/s_exp/jumble/account/view.clj
msgid "Stop on this device"
msgstr "Lopeta tällä laitteella"

#: src/s_exp/jumble/account/view.clj
msgid "This browser cannot show notifications."
msgstr "Tämä selain ei voi näyttää push-ilmoituksia."

#: src/s_exp/jumble/account/view.clj src/s_exp/jumble/error/view.clj
msgid "Something went wrong"
msgstr "Jokin meni vikaan"

#: src/s_exp/jumble/account/view.clj
msgid "Notifications are blocked for this site: allow them in the browser's settings, then try again."
msgstr "Push-ilmoitukset on estetty tällä sivustolla: salli ne selaimen asetuksista ja yritä sitten uudelleen."

#: src/s_exp/jumble/account/view.clj
msgid "On iPhone and iPad, add {app-name} to your home screen first, then turn notifications on from there."
msgstr "Lisää iPhonessa ja iPadissa palvelu {app-name} ensin Koti-valikkoon ja ota push-ilmoitukset käyttöön sieltä."

#: src/s_exp/jumble/account/view.clj
msgid "Devices notified"
msgstr "Push-ilmoituksia saavat laitteet"

#: src/s_exp/jumble/account/view.clj
msgid "Added {date}"
msgstr "Lisätty {date}"

#: src/s_exp/jumble/account/view.clj
msgid "This device"
msgstr "Tämä laite"

#: src/s_exp/jumble/account/view.clj src/s_exp/jumble/listing/view.clj
msgid "Remove"
msgstr "Poista"

#: src/s_exp/jumble/account/view.clj src/s_exp/jumble/page/privacy.clj src/s_exp/jumble/view/layout.clj
msgid "Settings"
msgstr "Asetukset"

#: src/s_exp/jumble/account/view.clj
msgid "Signed in as {email}"
msgstr "Kirjautuneena: {email}"

#: src/s_exp/jumble/account/view.clj
msgid "Name"
msgstr "Nimi"

#: src/s_exp/jumble/account/view.clj
msgid "Shown to other members on your listings and messages."
msgstr "Näkyy muille jäsenille ilmoituksissasi ja viesteissäsi."

#: src/s_exp/jumble/account/view.clj
msgid "Language"
msgstr "Kieli"

#: src/s_exp/jumble/account/view.clj
msgid "The community's ({language})"
msgstr "Yhteisön kieli ({language})"

#: src/s_exp/jumble/account/view.clj
msgid "Email"
msgstr "Sähköposti"

#: src/s_exp/jumble/account/view.clj
msgid "Email me when a message stays unread for a few minutes"
msgstr "Lähetä minulle sähköposti, kun viesti on ollut lukematta muutaman minuutin"

#: src/s_exp/jumble/account/view.clj
msgid "Email me once a week what is new on the board"
msgstr "Lähetä minulle kerran viikossa sähköposti ilmoitustaulun uutuuksista"

#: src/s_exp/jumble/account/view.clj src/s_exp/jumble/listing/view.clj src/s_exp/jumble/moderation/view.clj
msgid "Saved."
msgstr "Tallennettu."

#: src/s_exp/jumble/account/view.clj src/s_exp/jumble/moderation/view.clj
msgid "Save"
msgstr "Tallenna"

#: src/s_exp/jumble/account/view.clj
msgid "Your data"
msgstr "Tietosi"

#: src/s_exp/jumble/account/view.clj
msgid "{download-link} — your account, listings, favorites, conversations and reports, as a JSON file."
msgstr "{download-link} – tilisi, ilmoituksesi, suosikkisi, keskustelusi ja raporttisi JSON-tiedostona."

#: src/s_exp/jumble/account/view.clj
msgid "Download your data"
msgstr "Lataa tietosi"

#: src/s_exp/jumble/account/view.clj
msgid "Delete your account"
msgstr "Poista tilisi"

#: src/s_exp/jumble/account/view.clj
msgid "Delete your account?"
msgstr "Poistetaanko tilisi?"

#: src/s_exp/jumble/account/view.clj
msgid "Your listings and their photos, your favorites and your settings will be deleted, and you will be signed out. Messages you sent stay with the people you wrote to, from \"A former member\". This cannot be undone."
msgstr "Ilmoituksesi kuvineen, suosikkisi ja asetuksesi poistetaan, ja sinut kirjataan ulos. Lähettämäsi viestit jäävät vastaanottajille nimellä ”Entinen jäsen”. Tätä ei voi perua."

#: src/s_exp/jumble/account/view.clj
msgid "{download-link} first, if you want to keep a copy."
msgstr "{download-link} ensin, jos haluat säilyttää kopion."

#: src/s_exp/jumble/account/view.clj
msgid "Delete my account"
msgstr "Poista tilini"

#: src/s_exp/jumble/account/view.clj src/s_exp/jumble/listing/view.clj src/s_exp/jumble/moderation/view.clj
msgid "Keep it"
msgstr "Älä poista"

#: src/s_exp/jumble/account/view.clj
msgid "Email address"
msgstr "Sähköpostiosoite"

#: src/s_exp/jumble/account/view.clj
msgid "you@example.org"
msgstr "nimi@example.org"

#: src/s_exp/jumble/account/view.clj
msgid "Email me a link"
msgstr "Lähetä linkki"

#: src/s_exp/jumble/account/view.clj src/s_exp/jumble/web/routes.clj
msgid "Sign in"
msgstr "Kirjaudu sisään"

#: src/s_exp/jumble/account/view.clj
msgid "Enter your email address and we will send you a link to sign in."
msgstr "Anna sähköpostiosoitteesi, niin lähetämme sinulle kirjautumislinkin."

#: src/s_exp/jumble/account/view.clj
msgid "Join {app-name}"
msgstr "Liity palveluun {app-name}"

#: src/s_exp/jumble/account/view.clj
msgid "You are invited to {app-name}, where members sell, give away and lend things to each other."
msgstr "Sinut on kutsuttu palveluun {app-name}, jossa jäsenet myyvät, lahjoittavat ja lainaavat tavaroita toisilleen."

#: src/s_exp/jumble/account/view.clj
msgid "Sign in to join"
msgstr "Kirjaudu sisään liittyäksesi"

#: src/s_exp/jumble/account/view.clj
msgid "Check your inbox"
msgstr "Tarkista sähköpostisi"

#: src/s_exp/jumble/account/view.clj
msgid "If that address may sign in here, a link to sign in is on its way. It works once, within {n} minute."
msgid_plural "If that address may sign in here, a link to sign in is on its way. It works once, within {n} minutes."
msgstr[0] "Jos tällä osoitteella voi kirjautua tänne, kirjautumislinkki on matkalla. Se toimii kerran, {n} minuutin ajan."
msgstr[1] "Jos tällä osoitteella voi kirjautua tänne, kirjautumislinkki on matkalla. Se toimii kerran, {n} minuutin ajan."

#: src/s_exp/jumble/account/view.clj
msgid "Use another address"
msgstr "Käytä toista osoitetta"

#: src/s_exp/jumble/account/view.clj
msgid "Sign in as {email}?"
msgstr "Kirjaudutaanko osoitteella {email}?"

#: src/s_exp/jumble/chat/message.clj
msgid "New on {app-name}: {title}"
msgstr "Uutta palvelussa {app-name}: {title}"

#: src/s_exp/jumble/error/view.clj src/s_exp/jumble/view/layout.clj
msgid "Go to the home page"
msgstr "Siirry etusivulle"

#: src/s_exp/jumble/error/view.clj
msgid "The problem was logged. Please try again."
msgstr "Ongelma kirjattiin lokiin. Yritä uudelleen."

#: src/s_exp/jumble/error/view.clj
msgid "Bad request"
msgstr "Virheellinen pyyntö"

#: src/s_exp/jumble/error/view.clj
msgid "This request could not be understood."
msgstr "Pyyntöä ei voitu ymmärtää."

#: src/s_exp/jumble/error/view.clj
msgid "Too large"
msgstr "Liian suuri"

#: src/s_exp/jumble/error/view.clj
msgid "That request was larger than allowed."
msgstr "Pyyntö oli sallittua suurempi."

#: src/s_exp/jumble/error/view.clj
msgid "Not allowed"
msgstr "Ei sallittu"

#: src/s_exp/jumble/error/view.clj
msgid "You are not allowed to do this."
msgstr "Sinulla ei ole oikeutta tehdä tätä."

#: src/s_exp/jumble/error/view.clj
msgid "Not supported"
msgstr "Ei tuettu"

#: src/s_exp/jumble/error/view.clj
msgid "This cannot be done here."
msgstr "Tätä ei voi tehdä täällä."

#: src/s_exp/jumble/error/view.clj
msgid "Not possible right now"
msgstr "Ei onnistu juuri nyt"

#: src/s_exp/jumble/error/view.clj
msgid "This cannot be done as things stand. Reload the page and try again."
msgstr "Tämä ei onnistu nykytilanteessa. Lataa sivu uudelleen ja yritä uudestaan."

#: src/s_exp/jumble/error/view.clj
msgid "Too many requests"
msgstr "Liikaa pyyntöjä"

#: src/s_exp/jumble/error/view.clj
msgid "Please wait a moment, then try again."
msgstr "Odota hetki ja yritä sitten uudelleen."

#: src/s_exp/jumble/error/view.clj
msgid "Busy right now"
msgstr "Ruuhkaa juuri nyt"

#: src/s_exp/jumble/error/view.clj
msgid "Please try again in a moment."
msgstr "Yritä hetken päästä uudelleen."

#: src/s_exp/jumble/error/view.clj
msgid "Unavailable"
msgstr "Ei käytettävissä"

#: src/s_exp/jumble/error/view.clj
msgid "A service this depends on is not answering. Please try again later."
msgstr "Palvelu, jota tähän tarvitaan, ei vastaa. Yritä myöhemmin uudelleen."

#: src/s_exp/jumble/home/view.clj src/s_exp/jumble/moderation/view.clj
msgid "Give your things a {second-life} in your community."
msgstr "Anna tavaroillesi {second-life} omassa yhteisössäsi."

#: src/s_exp/jumble/home/view.clj src/s_exp/jumble/moderation/view.clj
msgid "second life"
msgstr "uusi elämä"

#: src/s_exp/jumble/home/view.clj src/s_exp/jumble/moderation/view.clj
msgid "Sell, give away or lend what you no longer need to people around you, and find what you were looking for."
msgstr "Myy, anna tai lainaa tarpeettomat tavarasi lähelläsi asuville ja löydä se, mitä etsit."

#: src/s_exp/jumble/home/view.clj
msgid "A bike, a desk lamp, a stroller…"
msgstr "Polkupyörä, työvalaisin, lastenrattaat…"

#: src/s_exp/jumble/home/view.clj src/s_exp/jumble/listing/view.clj
msgid "Search listings"
msgstr "Hae ilmoituksia"

#: src/s_exp/jumble/home/view.clj
msgid "Search"
msgstr "Hae"

#: src/s_exp/jumble/home/view.clj
msgid "{n} thing up for grabs right now"
msgid_plural "{n} things up for grabs right now"
msgstr[0] "{n} tavara tarjolla juuri nyt"
msgstr[1] "{n} tavaraa tarjolla juuri nyt"

#: src/s_exp/jumble/home/view.clj src/s_exp/jumble/listing/view.clj src/s_exp/jumble/view/layout.clj
msgid "Post a listing"
msgstr "Jätä ilmoitus"

#: src/s_exp/jumble/home/view.clj
msgid "or browse all listings →"
msgstr "tai selaa kaikkia ilmoituksia →"

#: src/s_exp/jumble/home/view.clj
msgid "Just posted"
msgstr "Uusimmat"

#: src/s_exp/jumble/home/view.clj
msgid "See all →"
msgstr "Näytä kaikki →"

#: src/s_exp/jumble/listing/choices.clj
msgid "Electronics"
msgstr "Elektroniikka"

#: src/s_exp/jumble/listing/choices.clj
msgid "Furniture & home"
msgstr "Huonekalut ja koti"

#: src/s_exp/jumble/listing/choices.clj
msgid "Kids & baby"
msgstr "Lapset ja vauvat"

#: src/s_exp/jumble/listing/choices.clj
msgid "Sports & outdoors"
msgstr "Urheilu ja ulkoilu"

#: src/s_exp/jumble/listing/choices.clj
msgid "Books & media"
msgstr "Kirjat ja media"

#: src/s_exp/jumble/listing/choices.clj
msgid "Clothing"
msgstr "Vaatteet"

#: src/s_exp/jumble/listing/choices.clj
msgid "Tickets & vouchers"
msgstr "Liput ja lahjakortit"

#: src/s_exp/jumble/listing/choices.clj
msgid "Other"
msgstr "Muut"

#: src/s_exp/jumble/listing/choices.clj
msgid "Give it a name."
msgstr "Anna nimi."

#: src/s_exp/jumble/listing/choices.clj
msgid "Keep the name to {max} characters or fewer."
msgstr "Nimessä voi olla enintään {max} merkkiä."

#: src/s_exp/jumble/listing/choices.clj
msgid "There is already one named “{label}”."
msgstr "Nimi ”{label}” on jo käytössä."

#: src/s_exp/jumble/listing/choices.clj
msgid "Keep at least one category."
msgstr "Jätä vähintään yksi kategoria."

#: src/s_exp/jumble/listing/controller.clj
msgid "Nothing to save"
msgstr "Ei tallennettavaa"

#: src/s_exp/jumble/listing/controller.clj
msgid "Search for something, or choose a type or a category, then save that."
msgstr "Hae jotain tai valitse tyyppi tai kategoria ja tallenna sitten haku."

#: src/s_exp/jumble/listing/controller.clj
msgid "Back to the listings"
msgstr "Takaisin ilmoituksiin"

#: src/s_exp/jumble/listing/controller.clj
msgid "Too many saved searches"
msgstr "Liikaa tallennettuja hakuja"

#: src/s_exp/jumble/listing/controller.clj
msgid "You can keep up to {max} saved searches. Remove one first."
msgstr "Voit pitää enintään {max} tallennettua hakua. Poista ensin jokin."

#: src/s_exp/jumble/listing/controller.clj src/s_exp/jumble/listing/view.clj
msgid "Your saved searches"
msgstr "Tallennetut hakusi"

#: src/s_exp/jumble/listing/controller.clj
msgid "This member does not exist, or no longer does."
msgstr "Tätä jäsentä ei ole olemassa tai hän ei ole enää jäsen."

#: src/s_exp/jumble/listing/controller.clj
msgid "This listing does not exist, or no longer does."
msgstr "Tätä ilmoitusta ei ole olemassa tai se on poistettu."

#: src/s_exp/jumble/listing/controller.clj
msgid "Not on the board"
msgstr "Ei ilmoitustaululla"

#: src/s_exp/jumble/listing/controller.clj
msgid "This listing is no longer on the board: put it back on the board instead."
msgstr "Tämä ilmoitus ei ole enää ilmoitustaululla: palauta se ilmoitustaululle."

#: src/s_exp/jumble/listing/controller.clj src/s_exp/jumble/moderation/view.clj
msgid "Back to the listing"
msgstr "Takaisin ilmoitukseen"

#: src/s_exp/jumble/listing/controller.clj
msgid "Only listings on the board can be edited. Put it back on the board first."
msgstr "Vain ilmoitustaululla olevia ilmoituksia voi muokata. Palauta se ensin ilmoitustaululle."

#: src/s_exp/jumble/listing/controller.clj
msgid "Back to the form"
msgstr "Takaisin lomakkeeseen"

#: src/s_exp/jumble/listing/controller.clj
msgid "Upload too large"
msgstr "Liian suuri lähetys"

#: src/s_exp/jumble/listing/controller.clj
msgid "A listing can have up to {max} photos of at most {megabytes} MB each."
msgstr "Ilmoituksessa voi olla enintään {max} kuvaa, kukin enintään {megabytes} Mt."

#: src/s_exp/jumble/listing/controller.clj src/s_exp/jumble/listing/model.clj
msgid "Too many photos are being processed right now. Please try again in a moment."
msgstr "Juuri nyt käsitellään liian montaa kuvaa. Yritä hetken päästä uudelleen."

#: src/s_exp/jumble/listing/freshness.clj
msgid "Still looking for \"{title}\"?"
msgstr "Etsitkö yhä: ”{title}”?"

#: src/s_exp/jumble/listing/freshness.clj
msgid "Is \"{title}\" still available?"
msgstr "Onko ”{title}” yhä saatavilla?"

#: src/s_exp/jumble/listing/freshness.clj
msgid "You posted \"{title}\" on {app-name} {n} day ago or more."
msgid_plural "You posted \"{title}\" on {app-name} {n} days ago or more."
msgstr[0] "Julkaisit ilmoituksen ”{title}” palvelussa {app-name} vähintään {n} päivä sitten."
msgstr[1] "Julkaisit ilmoituksen ”{title}” palvelussa {app-name} vähintään {n} päivää sitten."

#: src/s_exp/jumble/listing/freshness.clj
msgid "Still looking for it? Say so on its page, or mark it as found:"
msgstr "Etsitkö sitä yhä? Kerro se ilmoituksen sivulla tai merkitse se löytyneeksi:"

#: src/s_exp/jumble/listing/freshness.clj
msgid "Is it still available? Say so on its page, or mark it as gone:"
msgstr "Onko se yhä saatavilla? Kerro se ilmoituksen sivulla tai merkitse, ettei se ole enää saatavilla:"

#: src/s_exp/jumble/listing/freshness.clj
