msgid "Too many sign-ins were started from here. Please try again in a few minutes."
msgstr "Se han hecho demasiados intentos de inicio de sesión desde aquí. Vuelve a intentarlo en unos minutos."

#: src/s_exp/jumble/account/controller.clj
msgid "Account not allowed"
msgstr "Cuenta no autorizada"

#: src/s_exp/jumble/account/controller.clj
msgid "Only members of this community can sign in here."
msgstr "Solo los miembros de esta comunidad pueden iniciar sesión aquí."

#: src/s_exp/jumble/account/controller.clj
msgid "This community is full"
msgstr "Esta comunidad está completa"

#: src/s_exp/jumble/account/controller.clj
msgid "It has as many members as it can have. Ask its moderators to make room."
msgstr "Ya tiene tantos miembros como puede tener. Pide a sus moderadores que hagan sitio."

#: src/s_exp/jumble/account/controller.clj
msgid "Enter your email address."
msgstr "Introduce tu dirección de correo."

#: src/s_exp/jumble/account/controller.clj
msgid "“{email}” is not an email address."
msgstr "«{email}» no es una dirección de correo."

#: src/s_exp/jumble/account/controller.clj
msgid "Link expired"
msgstr "Enlace caducado"

#: src/s_exp/jumble/account/controller.clj
msgid "This sign-in link has expired or was already used."
msgstr "Este enlace de acceso ha caducado o ya se ha usado."

#: src/s_exp/jumble/account/controller.clj
msgid "Get a new link"
msgstr "Recibir un enlace nuevo"

#: src/s_exp/jumble/account/controller.clj
msgid "Sign-in expired"
msgstr "Inicio de sesión caducado"

#: src/s_exp/jumble/account/controller.clj
msgid "This sign-in is invalid or has expired."
msgstr "Este inicio de sesión no es válido o ha caducado."

#: src/s_exp/jumble/account/controller.clj
msgid "Sign-in refused"
msgstr "Inicio de sesión rechazado"

#: src/s_exp/jumble/account/controller.clj
msgid "The sign-in service refused the request."
msgstr "El servicio de inicio de sesión ha rechazado la solicitud."

#: src/s_exp/jumble/account/controller.clj
msgid "Email not verified"
msgstr "Correo no verificado"

#: src/s_exp/jumble/account/controller.clj
msgid "The sign-in service has not verified your email address."
msgstr "El servicio de inicio de sesión no ha verificado tu dirección de correo."

#: src/s_exp/jumble/account/controller.clj
msgid "Sign-in failed"
msgstr "Error al iniciar sesión"

#: src/s_exp/jumble/account/controller.clj
msgid "Something went wrong while signing you in."
msgstr "Algo ha fallado al iniciar tu sesión."

#: src/s_exp/jumble/account/controller.clj
msgid "Your account was deleted"
msgstr "Se ha eliminado tu cuenta"

#: src/s_exp/jumble/account/controller.clj
msgid "Your listings, photos and favorites are gone. Messages you sent stay with the people you wrote to, from \"A former member\"."
msgstr "Tus anuncios, fotos y favoritos se han eliminado. Los mensajes que enviaste siguen en manos de sus destinatarios, firmados como «Un antiguo miembro»."

#: src/s_exp/jumble/account/controller.clj
msgid "Done"
msgstr "Hecho"

#: src/s_exp/jumble/account/email.clj
msgid "Sign in to {app-name}"
msgstr "Inicia sesión en {app-name}"

#: src/s_exp/jumble/account/email.clj
msgid "Use this link to sign in to {app-name}:"
msgstr "Usa este enlace para iniciar sesión en {app-name}:"

#: src/s_exp/jumble/account/email.clj
msgid "It works once, within {n} minute. If you did not ask for it, you can\nignore this email: nobody can sign in without the link."
msgid_plural "It works once, within {n} minutes. If you did not ask for it, you can\nignore this email: nobody can sign in without the link."
msgstr[0] "Solo funciona una vez, durante {n} minuto. Si no lo has pedido, puedes\nignorar este correo: nadie puede iniciar sesión sin el enlace."
msgstr[1] "Solo funciona una vez, durante {n} minutos. Si no lo has pedido, puedes\nignorar este correo: nadie puede iniciar sesión sin el enlace."

#: src/s_exp/jumble/account/email.clj
msgid "You are invited to {app-name}"
msgstr "Te han invitado a {app-name}"

#: src/s_exp/jumble/account/email.clj
msgid "{inviter} invited you to {app-name}, where members sell, give away and lend things to each other."
msgstr "{inviter} te ha invitado a {app-name}, donde los miembros se venden, se regalan y se prestan cosas."

#: src/s_exp/jumble/account/email.clj
msgid "Sign in with this address: {url}"
msgstr "Inicia sesión con esta dirección de correo aquí: {url}"

#: src/s_exp/jumble/account/membership.clj
msgid "Not an email pattern: {pattern} (use *, name@domain, *@domain or *@*.domain)"
msgstr "No es un patrón de correo: {pattern} (usa *, nombre@dominio, *@dominio o *@*.dominio)"

#: src/s_exp/jumble/account/model.clj
msgid "Enter your name."
msgstr "Introduce tu nombre."

#: src/s_exp/jumble/account/model.clj
msgid "Keep your name to 80 characters or fewer."
msgstr "Tu nombre no puede superar los 80 caracteres."

#: src/s_exp/jumble/account/view.clj
msgid "Notifications on this device"
msgstr "Notificaciones en este dispositivo"

#: src/s_exp/jumble/account/view.clj
msgid "Get a notification here as soon as someone writes to you, even with {app-name} closed."
msgstr "Recibe una notificación aquí en cuanto alguien te escriba, incluso con {app-name} cerrado."

#: src/s_exp/jumble/account/view.clj
msgid "Notify me on this device"
msgstr "Avisarme en este dispositivo"

#: src/s_exp/jumble/account/view.clj
msgid "Stop on this device"
msgstr "Desactivar en este dispositivo"

#: src/s_exp/jumble/account/view.clj
msgid "This browser cannot show notifications."
msgstr "Este navegador no puede mostrar notificaciones."

#: src/s_exp/jumble/account/view.clj src/s_exp/jumble/error/view.clj
msgid "Something went wrong"
msgstr "Algo ha fallado"

#: src/s_exp/jumble/account/view.clj
msgid "Notifications are blocked for this site: allow them in the browser's settings, then try again."
msgstr "Las notificaciones están bloqueadas para este sitio: permítelas en los ajustes del navegador y vuelve a intentarlo."

#: src/s_exp/jumble/account/view.clj
msgid "On iPhone and iPad, add {app-name} to your home screen first, then turn notifications on from there."
msgstr "En iPhone y iPad, añade primero {app-name} a tu pantalla de inicio y activa las notificaciones desde allí."

#: src/s_exp/jumble/account/view.clj
msgid "Devices notified"
msgstr "Dispositivos avisados"

#: src/s_exp/jumble/account/view.clj
msgid "Added {date}"
msgstr "Añadido el {date}"

#: src/s_exp/jumble/account/view.clj
msgid "This device"
msgstr "Este dispositivo"

#: src/s_exp/jumble/account/view.clj src/s_exp/jumble/listing/view.clj
msgid "Remove"
msgstr "Eliminar"

