msgid "Sign in"
msgstr "Iniciar sesión"

#: src/s_exp/jumble/account/view.clj
msgid "Enter your email address and we will send you a link to sign in."
msgstr "Introduce tu dirección de correo y te enviaremos un enlace de acceso."

#: src/s_exp/jumble/account/view.clj
msgid "Email address"
msgstr "Dirección de correo"

#: src/s_exp/jumble/account/view.clj
msgid "you@example.org"
msgstr "tu@ejemplo.org"

#: src/s_exp/jumble/account/view.clj
msgid "Email me a link"
msgstr "Enviarme un enlace"

#: src/s_exp/jumble/account/view.clj
msgid "Check your inbox"
msgstr "Revisa tu bandeja de entrada"

#: src/s_exp/jumble/account/view.clj
msgid "If that address may sign in here, a link to sign in is on its way. It works once, within {n} minute."
msgid_plural "If that address may sign in here, a link to sign in is on its way. It works once, within {n} minutes."
msgstr[0] "Si esa dirección puede iniciar sesión aquí, te llegará un enlace de acceso. Solo funciona una vez, durante {n} minuto."
msgstr[1] "Si esa dirección puede iniciar sesión aquí, te llegará un enlace de acceso. Solo funciona una vez, durante {n} minutos."

