msgid "Choose a category."
msgstr "Elige una categoría."

#: src/s_exp/jumble/listing/model.clj
msgid "Choose where to pick it up."
msgstr "Elige dónde recogerlo."

#: src/s_exp/jumble/listing/model.clj
