msgid "Settings"
msgstr "Ajustes"

#: src/s_exp/jumble/account/view.clj
msgid "Signed in as {email}"
msgstr "Sesión iniciada como {email}"

#: src/s_exp/jumble/account/view.clj
msgid "Name"
msgstr "Nombre"

#: src/s_exp/jumble/account/view.clj
msgid "Shown to other members on your listings and messages."
msgstr "Lo ven los demás miembros en tus anuncios y mensajes."

#: src/s_exp/jumble/account/view.clj
msgid "Language"
msgstr "Idioma"

#: src/s_exp/jumble/account/view.clj
msgid "The community's ({language})"
msgstr "El de la comunidad ({language})"

#: src/s_exp/jumble/account/view.clj
msgid "Email"
msgstr "Correo"

#: src/s_exp/jumble/account/view.clj
msgid "Email me when a message stays unread for a few minutes"
msgstr "Avisarme por correo cuando un mensaje lleve unos minutos sin leer"

#: src/s_exp/jumble/account/view.clj
msgid "Email me once a week what is new on the board"
msgstr "Enviarme cada semana por correo las novedades del tablón"

#: src/s_exp/jumble/account/view.clj src/s_exp/jumble/listing/view.clj src/s_exp/jumble/moderation/view.clj
msgid "Saved."
msgstr "Guardado."

#: src/s_exp/jumble/account/view.clj src/s_exp/jumble/moderation/view.clj
msgid "Save"
msgstr "Guardar"

#: src/s_exp/jumble/account/view.clj
msgid "Your data"
msgstr "Tus datos"

#: src/s_exp/jumble/account/view.clj
msgid "{download-link} — your account, listings, favorites, conversations and reports, as a JSON file."
msgstr "{download-link} — tu cuenta, anuncios, favoritos, conversaciones y denuncias, en un archivo JSON."

