#: src/s_exp/jumble/error/view.clj
msgid "Please try again in a moment."
msgstr "Vuelve a intentarlo en un momento."

#: src/s_exp/jumble/error/view.clj
msgid "Unavailable"
msgstr "No disponible"

#: src/s_exp/jumble/error/view.clj
msgid "A service this depends on is not answering. Please try again later."
msgstr "Un servicio del que depende no responde. Vuelve a intentarlo más tarde."

#: src/s_exp/jumble/home/view.clj src/s_exp/jumble/moderation/view.clj
msgid "Give your things a {second-life} in your community."
msgstr "Dale una {second-life} a tus cosas en tu comunidad."

#: src/s_exp/jumble/home/view.clj src/s_exp/jumble/moderation/view.clj
msgid "second life"
msgstr "segunda vida"

#: src/s_exp/jumble/home/view.clj src/s_exp/jumble/moderation/view.clj
msgid "Sell, give away or lend what you no longer need to people around you, and find what you were looking for."
msgstr "Vende, regala o presta lo que ya no necesitas a la gente de tu entorno, y encuentra lo que buscabas."

