msgstr "¿Sigues buscando «{title}»?"

#: src/s_exp/jumble/listing/freshness.clj
msgid "Is \"{title}\" still available?"
msgstr "¿Sigue disponible «{title}»?"

#: src/s_exp/jumble/listing/freshness.clj
msgid "You posted \"{title}\" on {app-name} {n} day ago or more."
msgid_plural "You posted \"{title}\" on {app-name} {n} days ago or more."
msgstr[0] "Publicaste «{title}» en {app-name} hace {n} día o más."
msgstr[1] "Publicaste «{title}» en {app-name} hace {n} días o más."

