#: src/s_exp/jumble/account/controller.clj
msgid "Sign in again"
msgstr "Volver a iniciar sesión"

#: src/s_exp/jumble/account/controller.clj
msgid "Sign-in unavailable"
msgstr "Inicio de sesión no disponible"

#: src/s_exp/jumble/account/controller.clj
msgid "The sign-in service cannot be reached right now. Please try again shortly."
msgstr "El servicio de inicio de sesión no está disponible en este momento. Vuelve a intentarlo en breve."

