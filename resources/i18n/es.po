msgid "Download your data"
msgstr "Descargar tus datos"

#: src/s_exp/jumble/account/view.clj
msgid "Delete your account"
msgstr "Eliminar tu cuenta"

#: src/s_exp/jumble/account/view.clj
msgid "Delete your account?"
msgstr "¿Eliminar tu cuenta?"

#: src/s_exp/jumble/account/view.clj
msgid "Your listings and their photos, your favorites and your settings will be deleted, and you will be signed out. Messages you sent stay with the people you wrote to, from \"A former member\". This cannot be undone."
msgstr "Se eliminarán tus anuncios y sus fotos, tus favoritos y tus ajustes, y se cerrará tu sesión. Los mensajes que enviaste siguen en manos de sus destinatarios, firmados como «Un antiguo miembro». Esta acción no se puede deshacer."

#: src/s_exp/jumble/account/view.clj
msgid "{download-link} first, if you want to keep a copy."
msgstr "{download-link} antes, si quieres conservar una copia."

#: src/s_exp/jumble/account/view.clj
msgid "Delete my account"
msgstr "Eliminar mi cuenta"

#: src/s_exp/jumble/account/view.clj src/s_exp/jumble/listing/view.clj src/s_exp/jumble/moderation/view.clj
msgid "Keep it"
msgstr "Conservarlo"

