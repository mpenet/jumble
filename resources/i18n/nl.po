#: src/s_exp/jumble/moderation/view.clj
msgid "Members' invitations"
msgstr "Uitnodigingen door leden"

#: src/s_exp/jumble/moderation/view.clj
msgid "Members can invite people by email, {count} a day each. Whom they invited is listed below, to withdraw like any other address."
msgstr "Leden kunnen mensen per e-mail uitnodigen, elk {count} per dag. Wie ze uitnodigden staat hieronder en kan net als elk ander adres worden ingetrokken."

#: src/s_exp/jumble/moderation/view.clj
msgid "Members cannot invite people. Once you let them, each can invite {count} a day by email."
msgstr "Leden kunnen niemand uitnodigen. Als je het toestaat, kan elk lid {count} mensen per dag per e-mail uitnodigen."

